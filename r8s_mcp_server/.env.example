# -- R8S API connection --------------------------------------------------------
R8S_API_URL=https://your-r8s-api.example.com
R8S_USERNAME=your_username
R8S_PASSWORD=your_password

# -- MCP server ----------------------------------------------------------------
R8S_MCP_HOST=0.0.0.0
R8S_MCP_PORT=8080

# A comma-separated list of tenant names specified here will be marked as demo projects in the responses context.
R8S_DEMO_TENANT_NAMES='tenant1,tenant2,tenant3'