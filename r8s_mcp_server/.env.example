# -- R8S API connection --------------------------------------------------------
R8S_API_URL=https://your-r8s-api.example.com
R8S_USERNAME=your_username
R8S_PASSWORD=your_password

# Optional: path/name of the secret in the modular-sdk secrets backend (Vault or SSM)
# holding {"username": ..., "password": ...}. Only used when R8S_USERNAME/R8S_PASSWORD
# are unset and the server runs embedded in a modular-mcp host with
# MODULAR_SDK_SECRETS_BACKEND configured.
R8S_SECRET_VAULT_PATH=r8s-mcp/r8s_secret

# -- MCP server ----------------------------------------------------------------
R8S_MCP_HOST=0.0.0.0
R8S_MCP_PORT=8080

# A comma-separated list of tenant names specified here will be marked as demo projects in the responses context.
R8S_DEMO_TENANT_NAMES='tenant1,tenant2,tenant3'