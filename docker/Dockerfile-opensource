FROM python:3.14-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY src/requirements.txt /tmp/src-requirements.txt
COPY docker/requirements.txt /tmp/docker-requirements.txt
COPY src/exported_module/requirements.txt /tmp/exported-requirements.txt

RUN python -m venv /venv \
    && /venv/bin/pip install --upgrade pip \
    && /venv/bin/pip install \
        -r /tmp/src-requirements.txt \
        -r /tmp/docker-requirements.txt \
        -r /tmp/exported-requirements.txt

FROM python:3.14-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_ENV=production \
    APP_PORT=8000

WORKDIR /r8s/src

COPY --from=builder /venv /venv

COPY src /r8s/src
COPY docker /r8s/docker
COPY scripts /r8s/scripts

EXPOSE 8000

CMD ["bash", "-c", "/venv/bin/python exported_module/scripts/init.py && /venv/bin/python ../scripts/populate_aws_shapes.py && /venv/bin/python main.py"]
